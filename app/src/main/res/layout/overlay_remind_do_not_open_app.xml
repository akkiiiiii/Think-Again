<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    xmlns:motion="http://schemas.android.com/tools"
    android:background="@color/white"
    android:id="@+id/parent_motion_lay"
    motion:autoTransition="animateToEnd"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/overlay_remind_do_not_open_app_scene">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="@id/parent_motion_lay"
        app:layout_constraintStart_toStartOf="@id/parent_motion_lay"
        app:layout_constraintTop_toTopOf="@id/parent_motion_lay" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/parent_motion_lay"
        app:layout_constraintStart_toStartOf="@id/parent_motion_lay"
        app:layout_constraintTop_toTopOf="@id/parent_motion_lay" />


    <TextView
        android:id="@+id/notice_txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Do not try to do sin"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/anim_bottom"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/ghost_round" />


    <ImageView
        android:id="@+id/exit_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/exit"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/continue_txt"
        app:layout_constraintEnd_toEndOf="@+id/continue_txt"
        app:layout_constraintStart_toStartOf="@+id/continue_txt"
        app:layout_constraintTop_toTopOf="@+id/continue_txt" />

    <TextView
        android:id="@+id/continue_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="50dp"
        android:text="38"
        android:visibility="invisible"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/anim_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/anim_1" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/anim_1"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_rawRes="@raw/coffe_booty" />

</androidx.constraintlayout.motion.widget.MotionLayout>